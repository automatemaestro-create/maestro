# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage

# --- Node / JS ---
node_modules/
dist/
build/
.next/
out/

# Outils provisionnés localement par scripts/setup.sh (#153) : le Node épinglé par
# .node-version et les paquets MCP installés avec lui. Jamais versionnés — ce sont des
# binaires propres à la plateforme, reconstruits par `bash scripts/setup.sh --only node`.
.tools/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# --- Env & secrets ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/
# Coffre des secrets par agent (#109) : seul le README est versionné, jamais
# un coffre <agent>.json.
!core/secrets/
core/secrets/*
!core/secrets/README.md

# --- OS / éditeurs ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- Claude Code (surcharges personnelles ; .claude/settings.json et .mcp.json restent versionnés) ---
.claude/settings.local.json
# Tout ce qu'un script du dépôt écrit pour être relu SUR PLACE, sous la racine du worktree
# (docs/10 §8.5) : journaux du filet CI (`ci-local/`) et de `setup.sh`, journal d'orchestration
# (`orchestrate/`), atelier de session (`session/`, #307), et le profil du navigateur piloté par
# le MCP chrome-maestro quand MAESTRO_CHROME_PROFILE n'est pas posé. Local à un clone, jamais
# versionné — mais atteignable en chemin relatif, ce qui est toute la raison de le mettre là.
.maestro/

# --- Divers ---
coverage/
.cache/
tmp/

# --- Artefacts de la démo POC (maestro-demo, ticket #10) ---
sortie-demo/

# --- Livrables bureautiques (déjà versionnés sur Drive) ---
deliverables/
*.docx
*.pptx
~$*

# Artefacts de session du navigateur automatisé (MCP Playwright)
.playwright-mcp/
