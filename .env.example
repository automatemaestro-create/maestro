# Variables d'environnement — Maestro (Phase 0)
#
# Copiez ce fichier vers `.env` et renseignez vos valeurs. Le `.env` n'est
# JAMAIS commité (voir .gitignore). Ne mettez aucun secret réel dans CE
# fichier-ci : il sert uniquement de gabarit.

# --- Authentification Claude : DEUX modes, une bascule ---
# Maestro sait s'authentifier de deux façons (voir docs/07-guide-de-demarrage.md) :
#   • subscription : abonnement Claude Code (OAuth) — AUCUNE clé requise. C'est le
#                    point de départ du POC. Connectez-vous une fois via `claude`
#                    (ou, en CI, générez un token avec `claude setup-token`).
#   • api_key      : clé API Anthropic (facturation à l'usage).
#
# Sélecteur de mode. Laissez VIDE pour la déduction automatique (voir précédence),
# ou forcez explicitement `subscription` / `api_key`.
CLAUDE_AUTH_MODE=
#
# Règle de précédence (déterminée par maestro.providers.claude) :
#   1. si CLAUDE_AUTH_MODE est renseigné, il fait foi ;
#   2. sinon : ANTHROPIC_API_KEY présente ⇒ mode api_key, sinon ⇒ subscription.
# En mode api_key, ANTHROPIC_API_KEY est obligatoire. En mode subscription, Maestro
# neutralise toute clé/bearer ambiant pour bien utiliser l'abonnement.

# Clé API — requise UNIQUEMENT en mode api_key. À récupérer sur la console
# Anthropic. Ne jamais la committer ni la logguer.
ANTHROPIC_API_KEY=
# Token d'abonnement longue durée pour la CI (mode subscription sans navigateur).
# Généré par `claude setup-token`. Laissez vide en local si vous êtes connecté.
CLAUDE_CODE_OAUTH_TOKEN=
# Modèle par défaut de l'orchestrateur (optionnel).
ANTHROPIC_MODEL=claude-opus-4-8

# --- Bases locales optionnelles (via infra/docker-compose.yml) ---
# Décommentez si vous lancez PostgreSQL + Redis en local (voir infra/README.md).
# DATABASE_URL=postgresql://maestro:maestro@localhost:5432/maestro
# REDIS_URL=redis://localhost:6379/0

# --- Fournisseur de modèles (agnosticisme O7 / ENF-11, ticket #69) ---
# Fournisseur de l'exécution : `claude` (défaut) ou `openai` — ce dernier couvre
# TOUT endpoint compatible OpenAI (OpenAI, Mistral, Groq, OpenRouter, vLLM,
# Ollama…) via OPENAI_BASE_URL. La bascule est purement configurative : aucun
# changement de code ni de logique d'agent.
MAESTRO_PROVIDER=
# Modèle unique imposé à tous les rôles (orchestrateur + exécutants). REQUIS dès
# que MAESTRO_PROVIDER n'est pas `claude` (pas de modèle par défaut plausible
# hors Claude) ; laissez vide sinon pour garder les modèles du catalogue.
MAESTRO_MODEL=
# Clé API de l'endpoint compatible OpenAI (envoyée en Bearer). Optionnelle :
# laissez vide pour un endpoint local sans authentification (ex. Ollama).
OPENAI_API_KEY=
# Racine de l'endpoint compatible OpenAI. Défaut : https://api.openai.com/v1
# Ex. Mistral : https://api.mistral.ai/v1 — Ollama : http://localhost:11434/v1
OPENAI_BASE_URL=

# --- Observabilité Langfuse (traces & coûts des exécutions, ticket #81) ---
# Intégration OPTIONNELLE : laissez vide pour un fonctionnement identique, sans
# export. Renseignez les deux clés (projet Langfuse > Settings > API Keys) pour
# que chaque exécution (`maestro-run`, `maestro-demo`) produise une trace
# Langfuse : étapes, outils appelés, durées, tokens et coûts par tâche (#55).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Hôte Langfuse. Défaut : https://cloud.langfuse.com — pointez votre instance
# auto-hébergée le cas échéant.
LANGFUSE_HOST=
