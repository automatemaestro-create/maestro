{
  "mcpServers": {
    "chrome-maestro": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--browser=chrome",
        "--user-data-dir=${MAESTRO_CHROME_PROFILE:-.maestro/chrome-profile}"
      ]
    },
    "figma-officiel": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp"
    }
  }
}
